_jail-ai_commands() {
    local commands; commands=(
'create:Create a new jail' \
'remove:Remove a jail' \
'status:Show jail status' \
'save:Save jail configuration to file' \
'agents:Run AI agents. Agent variants are auto-generated from agents/mod.rs' \
'list:List all jails' \
'clean-all:Stop and remove all jail-ai containers' \
'upgrade:Upgrade jail by recreating it with the latest image' \
'completions:Generate shell completions and print them to stdout' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'jail-ai commands' commands "$@"
}
